FROM python:3.12-slim

WORKDIR /app

# ffmpeg: audio extraction from downloaded reels (app/workers/audio.py).
# Transcription is now a Groq API call, so no whisper.cpp / model download.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt

COPY app ./app

# Same .env as the API image — app.config.Settings validates the full set at
# import time even though the worker only reads a subset.
CMD ["python", "-m", "app.workers.run_worker"]
