MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGO_DB_NAME=dmprod
REDIS_URL=rediss://default:password@host:port
APP_ENCRYPTION_KEY=
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
CORS_ORIGIN=http://localhost:3000
# From the Meta App dashboard (App Settings > Basic > App Secret).
META_APP_SECRET=
# Your own arbitrary string — set here and paste the same value into the
# Meta App's webhook subscription config (Callback Verify Token).
WEBHOOK_VERIFY_TOKEN=
# The bot account's own long-lived access token (Meta App dashboard >
# Instagram > API setup > Generate access tokens). Used to look up the
# username of whoever DMs the bot — not a per-user token.
INSTAGRAM_BOT_ACCESS_TOKEN=
# Worker-only. Path to a ggml whisper.cpp model file (relative to cwd, or
# absolute). large-v3-turbo chosen for Hinglish (Hindi/English code-switched)
# accuracy — see app/workers/transcription.py. Local dev: brew install
# whisper-cpp, then download the model into backend/models/ (gitignored):
#   curl -L -o models/ggml-large-v3-turbo.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
WHISPER_MODEL_PATH=models/ggml-large-v3-turbo.bin
