MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGO_DB_NAME=dmprod
REDIS_URL=rediss://default:password@host:port
APP_ENCRYPTION_KEY=
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
CORS_ORIGIN=http://localhost:3000
# From the Meta App dashboard (App Settings > Basic > App Secret).
META_APP_SECRET=
# Your own arbitrary string — set here and paste the same value into the
# Meta App's webhook subscription config (Callback Verify Token).
WEBHOOK_VERIFY_TOKEN=
# The bot account's own long-lived access token (Meta App dashboard >
# Instagram > API setup > Generate access tokens). Used to look up the
# username of whoever DMs the bot — not a per-user token.
INSTAGRAM_BOT_ACCESS_TOKEN=
# Worker-only. Groq API key (https://console.groq.com/keys) — audio is
# transcribed via Groq's hosted Whisper, not a local model. Blank makes the
# transcription step fail with a clear "GROQ_API_KEY is not set" error.
GROQ_API_KEY=
# Optional. Defaults to whisper-large-v3 (best multilingual/Hinglish
# accuracy); set to whisper-large-v3-turbo for lower cost + latency.
GROQ_WHISPER_MODEL=whisper-large-v3
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client
# ID (type: Web application). Add this exact redirect URI there:
#   <CORS_ORIGIN>/api/google-calendar/callback   (e.g. http://localhost:3000/api/google-calendar/callback)
# Also enable the Google Calendar API for the project. Leave both blank to
# disable Google Calendar connect entirely (returns a clear error instead).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Phase 9 (comment-to-unlock) only. A `sessionid` cookie value from a real
# logged-in session on the bot's own Instagram account (browser -> log into
# instagram.com as the bot -> DevTools > Application > Cookies -> sessionid).
# Used only by instagrapi (unofficial private-API client) to follow/unfollow
# creators and post comments — a deliberate ToS trade-off, see
# plan/phase-09-comment-to-unlock.md. Leave blank to disable this feature
# entirely (comment-to-unlock detection still runs, the action just no-ops
# with a clear "not configured" log instead of failing oddly).
INSTAGRAM_SESSION_ID=
# Phase 13 (visual analysis) only. A Gemini API key from
# https://aistudio.google.com/apikey — deliberately app-level, not a user's
# own key: this step runs inside the shared content pipeline (process_reel),
# which has no per-user context to pull a key from (same reason Phase 6
# chose whisper.cpp over Gemini for transcription). Leave blank to disable
# this feature entirely (visual_processing_status="skipped", the rest of the
# pipeline and Phase 7's per-user task generation are unaffected).
VISUAL_ANALYSIS_GEMINI_API_KEY=
